{
  "manifest_version": 3,
  "name": "AnyMD Mixtmoji Kitchen",
  "version": "1.0.0",
  "description": "Bake custom emoji & kaomoji mashups and inject them directly into active text inputs, with AnyMD sync.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "anymd-mixtmoji-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["anymd-mixtmoji-content.js"]
    }
  ]
}
