{
  "name": "anymddb-book-acquisitions",
  "version": "1.0.0",
  "description": "AnyMDDB plugin bundle for curated book list ingestion (NYT, Kindle, Seven Seas) and multi-source digital acquisition (Gutenberg, Open Library, Anna's Archive, OverDrive).",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "sync:vps": "bash scripts/sync-wishlist-vps.sh"
  },
  "keywords": [
    "anymddb",
    "markdown",
    "book-curator",
    "acquisition",
    "nyt-bestsellers",
    "seven-seas",
    "kindle",
    "gutenberg",
    "openlibrary",
    "annas-archive"
  ],
  "author": "Laura Flores",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
