{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "types": ["node"]
  },
  "include": [
    "src/security/**/*",
    "src/export/**/*",
    "src/community/**/*",
    "src/plugins/**/*",
    "tests/**/*",
    "AnymdCore.ts",
    "AnymdPlugins.ts"
  ]
}
