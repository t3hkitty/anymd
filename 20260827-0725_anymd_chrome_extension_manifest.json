{
  "manifest_version": 3,
  "name": "AnyMD Universal Gutter Companion",
  "version": "3.0.0",
  "description": "Empathetic sidebar companion supporting left/right toggling, ambient audio looms, and inline @link snapshot cards.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cat_16.png",
      "48": "icons/cat_48.png",
      "128": "icons/cat_128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["sidebar_mount.css"]
    }
  ],
  "icons": {
    "16": "icons/cat_16.png",
    "48": "icons/cat_48.png",
    "128": "icons/cat_128.png"
  }
}
