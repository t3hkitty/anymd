{
  "manifest_version": 3,
  "name": "🐾 Meow MUD Browser Extension (bext)",
  "version": "1.0.0",
  "description": "Capture web selections, highlight text, and inject them directly into your offline Meow MUD engine and AnyMD vaults.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
