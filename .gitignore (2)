# .gitignore
# Enforces safe file containment limits within your local client repository.
# Prevents sensitive server/client keys and credential caches from leaking into Git.

# --- Private Cryptographic Keys & Tokens ---
*.key
*.key.pub
id_ed25519_ocpkit
id_ed25519_ocpkit.pub
ssh-key-*.key
ssh-key-*.pub
authorized_keys

# --- Local Environment & Secret Stores ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.flaskenv

# --- System & Editor Configurations ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Temporary Logs & Cache Directories ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
__pycache__/
.pytest_cache/
.serverless/
.fusebox/
.dynamodb/
node_modules/
/dist
/build
out/
scratch/
